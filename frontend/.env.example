# Public configuration only.
#
# The frontend never receives backend secrets. Do not add GROQ_API_KEY,
# SERPAPI_KEY, DATABASE_URL or any other private value here: every VITE_*
# variable is inlined into the public JavaScript bundle.
#
# Copy this file to `.env.local` to override the value for local development.
VITE_API_BASE_URL=http://127.0.0.1:8000
