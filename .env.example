# ---------- InvestShield AI ----------
# Copy this file to `.env` and fill in the values you have.
# NEVER commit `.env`. All secrets stay local.

# ---------- Application ----------
APP_NAME=investshield-ai
VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api

# ---------- Database ----------
# Local SQLite (default). Portable to Neon/PostgreSQL by changing only this.
# DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://neondb_owner:npg_GlImHx8rkM1W@ep-dawn-hall-b5h04enr-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- LLM (Groq is the primary provider) ----------
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2

# ---------- Search ----------
SEARCH_PROVIDER=serpapi
SERPAPI_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SEARCH_TIMEOUT_SECONDS=15
SEARCH_MAX_RESULTS=10

# ---------- Embeddings ----------
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------- OCR ----------
# Leave empty to auto-detect. On Windows the default fallback is
# C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANGUAGES=eng

# ---------- PDF ----------
PDF_MAX_PAGES=100

# ---------- Uploads ----------
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_TYPES=image/png,image/jpeg,image/webp,application/pdf

# ---------- Risk engine ----------
# Heuristic indicator weights (override to tune). Not probabilities.
RISK_WEIGHT_GUARANTEED_RETURN=20
RISK_WEIGHT_UNREALISTIC_RETURN=25
RISK_WEIGHT_URGENCY_PRESSURE=15
RISK_WEIGHT_FAKE_REGULATORY_CLAIM=25
RISK_WEIGHT_UNVERIFIED_ADVISER=20
RISK_WEIGHT_SUSPICIOUS_URL=10
RISK_WEIGHT_THIRD_PARTY_PAYMENT=15
RISK_WEIGHT_APK_DOWNLOAD=25
RISK_WEIGHT_MESSAGING_INVESTMENT_GROUP=10
RISK_WEIGHT_BORROW_TO_INVEST=20
RISK_WEIGHT_WITHDRAWAL_FEE=25
RISK_WEIGHT_ACCOUNT_ACTIVATION_FEE=20
RISK_WEIGHT_FAKE_PROFIT_SCREENSHOT=15
RISK_WEIGHT_IMPERSONATION=20

# Risk band upper bounds (inclusive). Score above the last bound = CRITICAL.
RISK_BAND_MEDIUM_MAX=20
RISK_BAND_HIGH_MAX=50
RISK_BAND_CRITICAL_MAX=90
